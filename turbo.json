{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "COOKIE_PREFIX",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "DIRECT_URL",
    "RESEND_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck", "lint"],
      "outputs": ["frontend/dist"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "postinstall": {
      "cache": false
    }
  }
}
