{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "COOKIE_PREFIX",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "DIRECT_URL",
    "RESEND_API_KEY",
    "RESEND_EMAIL"
  ],
  "tasks": {
    "db:generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^db:generate", "^build", "typecheck", "lint"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "postinstall": {
      "cache": false
    }
  }
}
