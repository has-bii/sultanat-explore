{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "COOKIE_PREFIX",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "DIRECT_URL",
    "RESEND_API_KEY",
    "RESEND_EMAIL",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_PUBLIC_DOMAIN",
    "NEXT_PUBLIC_API_URL"
  ],
  "tasks": {
    "db:generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/prisma/**"]
    },
    "typecheck": {
      "dependsOn": ["db:generate"],
      "cache": true,
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json", "prisma/schema.prisma"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["typecheck"],
      "cache": true,
      "inputs": ["src/**/*.ts", "src/**/*.tsx", ".eslintrc*", "eslint.config*"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": ["lint"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "public/**",
        "next.config*",
        "tsconfig.json",
        ".env*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
